{
  "name": "kharchalens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1",
    "build": "vite build && node scripts/check-performance-budgets.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/config/__tests__/*.test.ts src/domain/__tests__/*.test.ts src/features/**/__tests__/*.test.ts src/server/__tests__/*.test.ts src/services/export/__tests__/*.test.ts src/services/ai/__tests__/*.test.ts src/services/firebase/__tests__/errors.test.ts src/services/firebase/__tests__/receiptHydrationCache.test.ts",
    "test:firestore": "firebase emulators:exec --only firestore \"npx tsx --test src/services/firebase/__tests__/firestore.rules.test.ts src/services/firebase/__tests__/integration.test.ts\"",
    "setup:e2e": "playwright install chromium",
    "test:e2e": "node scripts/ensure-playwright-chromium.mjs && playwright test",
    "perf:bundle": "node scripts/check-performance-budgets.mjs",
    "test": "npm run test:unit && npm run test:firestore",
    "verify": "node scripts/run-verification.mjs",
    "update-report": "node scripts/run-verification.mjs --write-report"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "multer": "^2.2.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-tools": "15.28.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
