# Copy this file to .env.local for local development. Do not commit .env.local.
# For Vercel, add the same values in the project Environment Variables screen.
# Firebase web configuration. These values identify the web app; Firestore
# rules and Firebase Auth enforce access. They do not replace server credentials.
# All VITE_FIREBASE_* values are required together for preview and production.
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"

# Firebase Admin configuration for the local/Vercel extraction and deletion API.
# Keep this service-account JSON private and use a single-line JSON value.
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "your-project-id", ...}'
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_DATABASE_ID="(default)"

# Development/test only: use local Application Default Credentials instead of
# FIREBASE_SERVICE_ACCOUNT. Never set this in production.
FIREBASE_ADMIN_USE_ADC="false"

# Server-only pinned model ID. Do not use a VITE_ prefix or a *-latest alias.
GEMINI_EXTRACTION_MODEL="your-pinned-gemini-model-id"
