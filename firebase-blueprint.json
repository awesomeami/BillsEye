{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 255 },
        "displayName": { "type": "string", "maxLength": 255 },
        "createdAt": { "type": "timestamp" },
        "lastLoginAt": { "type": "timestamp" },
        "schemaVersion": { "type": "number", "minimum": 1, "maximum": 1 }
      },
      "required": ["email", "createdAt", "lastLoginAt", "schemaVersion"]
    },
    "ReceiptItem": {
      "title": "ReceiptItem",
      "description": "Line item in a receipt",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "rawLineText": { "type": "string", "maxLength": 500 },
        "name": { "type": "string", "maxLength": 200 },
        "brand": { "type": "string", "maxLength": 100 },
        "quantity": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "maxLength": 50 },
        "unitPrice": { "type": "number", "minimum": 0 },
        "discount": { "type": "number", "minimum": 0 },
        "lineTotal": { "type": "number", "minimum": 0 },
        "category": { "type": "string", "maxLength": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "userEdited": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 10 }
      },
      "required": ["id"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "A receipt document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "schemaVersion": { "type": "number", "minimum": 1, "maximum": 2 },
        "revision": { "type": "number", "minimum": 1 },
        "status": { "type": "string", "enum": ["pendingReview", "confirmed"] },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" },
        "confirmedAt": { "type": "timestamp" },
        "sourceFileName": { "type": "string", "maxLength": 255 },
        "sourceMimeType": { "type": "string", "maxLength": 100 },
        "sourceSha256": { "type": "string", "maxLength": 64 },
        "sourcePageNumber": { "type": "number", "minimum": 1 },
        "merchantRaw": { "type": "string", "maxLength": 255 },
        "merchantNormalized": { "type": "string", "maxLength": 255 },
        "branchAddress": { "type": "string", "maxLength": 500 },
        "receiptNumber": { "type": "string", "maxLength": 100 },
        "transactionDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "transactionTime": { "type": "string", "maxLength": 20 },
        "dateAmbiguous": { "type": "boolean" },
        "currency": { "type": "string", "maxLength": 10 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "items": { "type": "array", "items": { "$ref": "#/entities/ReceiptItem" }, "maxItems": 200 },
        "printedSubtotal": { "type": "number", "minimum": 0 },
        "printedDiscount": { "type": "number", "minimum": 0 },
        "printedTax": { "type": "number", "minimum": 0 },
        "printedFees": { "type": "number", "minimum": 0 },
        "printedRounding": { "type": "number" },
        "printedGrandTotal": { "type": "number", "minimum": 0 },
        "computedLineTotal": { "type": "number", "minimum": 0 },
        "computedExpectedTotal": { "type": "number", "minimum": 0 },
        "discrepancy": { "type": "number" },
        "reconciliationStatus": { "type": "string", "enum": ["matched", "mismatched", "unknown"] },
        "rawOcrText": { "type": "string", "maxLength": 100000 },
        "overallConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": { "type": "array", "items": { "type": "string", "maxLength": 255 }, "maxItems": 20 },
        "ambiguousFields": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "maxItems": 20 },
        "extractionModel": { "type": "string", "maxLength": 100 },
        "extractionSchemaVersion": { "type": "string", "maxLength": 50 },
        "extractionDurationMs": { "type": "number", "minimum": 0 },
        "userNote": { "type": "string", "maxLength": 500 },
        "wasEditedByUser": { "type": "boolean" }
      },
      "required": ["id", "schemaVersion", "revision", "status", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Category for expense tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "isCustom": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "color": { "type": "string", "maxLength": 50 },
        "icon": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "isCustom", "createdAt", "order", "isActive"]
    },
    "Alias": {
      "title": "Alias",
      "description": "Merchant to Category Alias",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "merchantNormalized": { "type": "string", "maxLength": 255 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "merchantNormalized", "categoryId", "createdAt", "updatedAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "User app settings",
      "type": "object",
      "properties": {
        "currency": { "type": "string", "maxLength": 10 },
        "locale": { "type": "string", "maxLength": 20 },
        "timeZone": { "type": "string", "maxLength": 50 },
        "theme": { "type": "string", "enum": ["light", "dark", "system"] },
        "lowConfidenceThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "discrepancyTolerance": { "type": "number", "minimum": 0 }
      },
      "required": []
    }
  },
  "firestore": {
    "users/{uid}": { "schema": "UserProfile", "description": "User profile" },
    "users/{uid}/receipts/{receiptId}": { "schema": "Receipt", "description": "User's receipts" },
    "users/{uid}/categories/{categoryId}": { "schema": "Category", "description": "User's custom and default categories" },
    "users/{uid}/aliases/{aliasId}": { "schema": "Alias", "description": "User's merchant-to-category aliases" },
    "users/{uid}/settings/{settingId}": { "schema": "AppSettings", "description": "User's settings" }
  }
}
