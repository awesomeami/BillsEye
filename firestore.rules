rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidReceiptItemSlot(slot) {
      // One document per slot bounds a receipt to forty items without trying
      // to iterate a list in Rules.
      return slot is string && slot.matches('^([0-9]|[1-2][0-9]|3[0-9])$');
    }

    function checkStringOrNull(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }
    function checkNumberOrNull(val, minVal, maxVal) {
      return val == null || (val is number && val >= minVal && val <= maxVal);
    }
    function checkNumberOrNullNoMax(val, minVal) {
      return val == null || (val is number && val >= minVal);
    }
    function checkNumberOrNullAny(val) {
      return val == null || val is number;
    }
    function checkBoolOrNull(val) {
      return val == null || val is bool;
    }

    function isBoundedString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Rules cannot iterate a list, so validate every supported warning slot.
    // Nesting makes the usual short list case short-circuit, keeping valid
    // receipt-header writes below the platform expression limit while still
    // rejecting maps, blobs, and image-like values in every supported slot.
    function checkStringList(val, maxItems, maxLen) {
      return val is list && val.size() <= maxItems
        && (val.size() == 0 || (isBoundedString(val[0], maxLen)
          && (val.size() == 1 || (isBoundedString(val[1], maxLen)
          && (val.size() == 2 || (isBoundedString(val[2], maxLen)
          && (val.size() == 3 || (isBoundedString(val[3], maxLen)
          && (val.size() == 4 || (isBoundedString(val[4], maxLen)
          && (val.size() == 5 || (isBoundedString(val[5], maxLen)
          && (val.size() == 6 || (isBoundedString(val[6], maxLen)
          && (val.size() == 7 || (isBoundedString(val[7], maxLen)
          && (val.size() == 8 || (isBoundedString(val[8], maxLen)
          && (val.size() == 9 || (isBoundedString(val[9], maxLen)
          && (val.size() == 10 || (isBoundedString(val[10], maxLen)
          && (val.size() == 11 || (isBoundedString(val[11], maxLen)
          && (val.size() == 12 || (isBoundedString(val[12], maxLen)
          && (val.size() == 13 || (isBoundedString(val[13], maxLen)
          && (val.size() == 14 || (isBoundedString(val[14], maxLen)
          && (val.size() == 15 || (isBoundedString(val[15], maxLen)
          && (val.size() == 16 || (isBoundedString(val[16], maxLen)
          && (val.size() == 17 || (isBoundedString(val[17], maxLen)
          && (val.size() == 18 || (isBoundedString(val[18], maxLen)
          && (val.size() == 19 || (isBoundedString(val[19], maxLen)
          && val.size() == 20
          ) ) ) ) ) ) ) ) ) )
          ) ) ) ) ) ) ) ) ) )
          ) ) ) ) ) ) ) ) ) )
          ) ) ) ) ) ) ) ) ) );
    }
    
    function isValidReceiptItem(item) {
      return item is map 
        && item.keys().hasAll(['id'])
        && item.keys().hasOnly(['id', 'rawLineText', 'name', 'brand', 'quantity', 'unit', 'unitPrice', 'discount', 'lineTotal', 'categoryId', 'category', 'confidence', 'userEdited', 'warnings'])
        && item.id is string && item.id.size() <= 128
        && checkStringOrNull(item.get('rawLineText', null), 500)
        && checkStringOrNull(item.get('name', null), 200)
        && checkStringOrNull(item.get('brand', null), 100)
        && checkNumberOrNullNoMax(item.get('quantity', null), 0)
        && checkStringOrNull(item.get('unit', null), 50)
        && checkNumberOrNullAny(item.get('unitPrice', null))
        && checkNumberOrNullAny(item.get('discount', null))
        && checkNumberOrNullAny(item.get('lineTotal', null))
        && (item.get('categoryId', null) == null || isValidId(item.get('categoryId', null)))
        && checkStringOrNull(item.get('category', null), 100)
        && checkNumberOrNull(item.get('confidence', null), 0, 1)
        && checkBoolOrNull(item.get('userEdited', null))
        && checkStringList(item.get('warnings', []), 10, 200);
    }
    
    function isValidReceipt(data) {
      return data is map
        && data.keys().hasAll(['id', 'schemaVersion', 'revision', 'status', 'createdAt', 'updatedAt', 'itemStorageVersion', 'items'])
        && data.keys().hasOnly([
          'id', 'schemaVersion', 'revision', 'status', 'createdAt', 'updatedAt', 'confirmedAt',
          'sourceFileName', 'sourceMimeType', 'sourceSha256', 'sourcePageNumber',
          'merchantRaw', 'merchantNormalized', 'branchAddress', 'receiptNumber',
          'transactionDate', 'transactionTime', 'dateAmbiguous', 'currency', 'paymentMethod', 'items',
          'printedSubtotal', 'printedDiscount', 'printedTax', 'printedFees', 'printedRounding', 'printedGrandTotal',
          'computedLineTotal', 'computedExpectedTotal', 'discrepancy', 'reconciliationStatus',
          'rawOcrText', 'overallConfidence', 'warnings', 'ambiguousFields',
          'extractionModel', 'extractionModelActual', 'extractionSchemaVersion', 'extractionDurationMs',
          'userNote', 'wasEditedByUser', 'itemStorageVersion'
        ])
        && data.id is string && data.id.size() <= 128
        && data.schemaVersion is number && data.schemaVersion >= 1 && data.schemaVersion <= 2
        && data.revision is number && data.revision >= 1
        && data.status in ['pendingReview', 'confirmed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.itemStorageVersion is number && data.itemStorageVersion == 2
        && (data.get('confirmedAt', null) == null || data.get('confirmedAt', null) is timestamp)
        && checkStringOrNull(data.get('sourceFileName', null), 255)
        && checkStringOrNull(data.get('sourceMimeType', null), 100)
        && checkStringOrNull(data.get('sourceSha256', null), 64)
        && checkNumberOrNullNoMax(data.get('sourcePageNumber', null), 1)
        && checkStringOrNull(data.get('merchantRaw', null), 255)
        && checkStringOrNull(data.get('merchantNormalized', null), 255)
        && checkStringOrNull(data.get('branchAddress', null), 500)
        && checkStringOrNull(data.get('receiptNumber', null), 100)
        && (data.get('transactionDate', null) == null || (data.get('transactionDate', null) is string && data.get('transactionDate', null).matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && checkStringOrNull(data.get('transactionTime', null), 20)
        && checkBoolOrNull(data.get('dateAmbiguous', null))
        && checkStringOrNull(data.get('currency', null), 10)
        && checkStringOrNull(data.get('paymentMethod', null), 50)
        && checkNumberOrNullAny(data.get('printedSubtotal', null))
        && checkNumberOrNullAny(data.get('printedDiscount', null))
        && checkNumberOrNullAny(data.get('printedTax', null))
        && checkNumberOrNullAny(data.get('printedFees', null))
        && (data.get('printedRounding', null) == null || data.get('printedRounding', null) is number)
        && checkNumberOrNullAny(data.get('printedGrandTotal', null))
        && checkNumberOrNullAny(data.get('computedLineTotal', null))
        && checkNumberOrNullAny(data.get('computedExpectedTotal', null))
        && (data.get('discrepancy', null) == null || data.get('discrepancy', null) is number)
        && (data.get('reconciliationStatus', null) == null || data.get('reconciliationStatus', null) in ['matched', 'mismatched', 'unknown'])
        && checkStringOrNull(data.get('rawOcrText', null), 100000)
        && checkNumberOrNull(data.get('overallConfidence', null), 0, 1)
        && checkStringList(data.get('warnings', []), 20, 255)
        && checkStringList(data.get('ambiguousFields', []), 20, 100)
        && checkStringOrNull(data.get('extractionModel', null), 100)
        && checkStringOrNull(data.get('extractionModelActual', null), 100)
        && checkStringOrNull(data.get('extractionSchemaVersion', null), 50)
        && checkNumberOrNullNoMax(data.get('extractionDurationMs', null), 0)
        && checkStringOrNull(data.get('userNote', null), 500)
        && checkBoolOrNull(data.get('wasEditedByUser', null))
        // The parent has no inline items. Each item is validated independently
        // in the nested /items collection, avoiding Rules' list-expression cap.
        && data.items is list && data.items.size() == 0;
    }
    
    function isValidCategory(data) {
      return data is map
        && data.keys().hasAll(['id', 'name', 'isCustom', 'createdAt', 'order', 'isActive'])
        && data.keys().hasOnly(['id', 'name', 'legacyNames', 'isCustom', 'createdAt', 'color', 'icon', 'order', 'isActive'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && checkStringList(data.get('legacyNames', []), 20, 100)
        && data.isCustom is bool
        && data.createdAt is string && data.createdAt.size() <= 50
        && checkStringOrNull(data.get('color', null), 50)
        && checkStringOrNull(data.get('icon', null), 50)
        && data.order is number
        && data.isActive is bool;
    }
    
    function isValidAlias(data) {
      return data is map
        && data.keys().hasAll(['id', 'merchantNormalized', 'categoryId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'merchantNormalized', 'categoryId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.merchantNormalized is string && data.merchantNormalized.size() <= 255
        && data.categoryId is string && data.categoryId.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidSettings(data) {
      return data is map
        && data.keys().hasOnly(['currency', 'locale', 'timeZone', 'theme', 'lowConfidenceThreshold', 'discrepancyTolerance'])
        && checkStringOrNull(data.get('currency', null), 10)
        && checkStringOrNull(data.get('locale', null), 20)
        && checkStringOrNull(data.get('timeZone', null), 50)
        && (data.get('theme', null) == null || data.get('theme', null) in ['light', 'dark', 'system'])
        && checkNumberOrNull(data.get('lowConfidenceThreshold', null), 0, 1)
        && checkNumberOrNullNoMax(data.get('discrepancyTolerance', null), 0);
    }

    function isValidSyncDiagnostic(data) {
      return data is map
        && data.keys().hasAll(['lastTest', 'device'])
        && data.keys().hasOnly(['lastTest', 'device'])
        && data.lastTest is timestamp
        && data.device is string && data.device.size() <= 50;
    }
    
    function isValidUserProfile(data) {
      return data is map
        && data.keys().hasAll(['email', 'createdAt', 'lastLoginAt', 'schemaVersion'])
        && data.keys().hasOnly(['email', 'displayName', 'createdAt', 'lastLoginAt', 'schemaVersion'])
        && data.email is string && data.email.size() <= 255
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp
        && data.schemaVersion is number && data.schemaVersion >= 1
        && checkStringOrNull(data.get('displayName', null), 255);
    }
    
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUserProfile(incoming());
      allow update: if isOwner(uid) && isValidUserProfile(incoming()) 
        && incoming().createdAt == existing().createdAt 
        && incoming().email == existing().email;
      allow delete: if false; // Only via Functions or Admin
      
      match /receipts/{receiptId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) 
          && isValidId(receiptId)
          && isValidReceipt(incoming()) 
          && incoming().id == receiptId;
        allow update: if isOwner(uid) 
          && isValidId(receiptId)
          && isValidReceipt(incoming()) 
          && incoming().id == receiptId
          && incoming().createdAt == existing().createdAt
          && incoming().revision > existing().revision;
        allow delete: if isOwner(uid) && isValidId(receiptId);

        match /items/{itemSlot} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && isValidId(receiptId)
            && isValidReceiptItemSlot(itemSlot)
            && existsAfter(/databases/$(database)/documents/users/$(uid)/receipts/$(receiptId))
            && isValidReceiptItem(incoming())
            && incoming().id is string;
          allow update: if isOwner(uid)
            && isValidId(receiptId)
            && isValidReceiptItemSlot(itemSlot)
            && existsAfter(/databases/$(database)/documents/users/$(uid)/receipts/$(receiptId))
            && isValidReceiptItem(incoming())
            && incoming().id is string;
          allow delete: if isOwner(uid) && isValidId(receiptId) && isValidReceiptItemSlot(itemSlot);
        }
      }
      
      match /categories/{categoryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidId(categoryId) && isValidCategory(incoming()) && incoming().id == categoryId;
        allow update: if isOwner(uid) && isValidId(categoryId) && isValidCategory(incoming()) && incoming().id == categoryId;
        allow delete: if isOwner(uid) && isValidId(categoryId);
      }
      
      match /aliases/{aliasId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidId(aliasId) && isValidAlias(incoming()) && incoming().id == aliasId;
        allow update: if isOwner(uid) && isValidId(aliasId) && isValidAlias(incoming()) && incoming().id == aliasId;
        allow delete: if isOwner(uid) && isValidId(aliasId);
      }
      
      match /settings/{settingId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && ((settingId == 'default' && isValidSettings(incoming()))
            || (settingId == 'sync-test' && isValidSyncDiagnostic(incoming())));
        allow delete: if isOwner(uid) && settingId == 'sync-test';
      }
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
